generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMERATIONS
// ==========================================

enum Role {
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
}

enum GradeApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExerciseDifficulty {
  STANDARD
  INTERMEDIATE
  ADVANCED
}

enum ExerciseStatus {
  DRAFT
  PUBLISHED
}

// Type de parcours de la classe ou de la cohorte
enum EducationType {
  SCHOOL
  PROFESSIONAL
}

enum LearningCourseStatus {
  DRAFT
  PUBLISHED
}

enum LearningAssessmentKind {
  PLACEMENT
  FINAL
}

enum LearningLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// ==========================================
// AUTHENTIFICATION AUTH.JS
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// UTILISATEURS
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(STUDENT)

  // Auth.js
  accounts Account[]
  sessions Session[]

  // Profils
  studentProfile Student?        @relation("UserToStudent")
  teacherProfile TeacherProfile? @relation("UserToTeacher")
  parentProfile  ParentProfile?  @relation("UserToParentProfile")

  // Relations parentales et financières
  parentStudents Student[] @relation("ParentToStudent")
  invoices       Invoice[] @relation("ParentInvoices")

  // Activités pédagogiques
  teacherAssignments   TeachingAssignment[]  @relation("TeacherAssignments")
  schedules            Schedule[]            @relation("TeacherSchedules")
  teacherAppreciations TeacherAppreciation[] @relation("UserTeacherAppreciations")

  // Notes soumises et vérifiées
  submittedGrades Grade[] @relation("SubmittedGrades")
  reviewedGrades  Grade[] @relation("ReviewedGrades")

  // Exercices créés
  createdExercises Exercise[] @relation("CreatedExercises")

  createdHomeworks          Homework[]           @relation("CreatedHomeworks")
  gradedHomeworkSubmissions HomeworkSubmission[] @relation("GradedHomeworkSubmissions")
}

// ==========================================
// PROFIL ENSEIGNANT
// ==========================================

model TeacherProfile {
  id     String @id @default(cuid())
  userId String @unique

  user User @relation("UserToTeacher", fields: [userId], references: [id], onDelete: Cascade)

  phone           String?
  address         String?
  specialty       String?
  degree          String?
  pedagogicalInfo String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ==========================================
// APPRECIATIONS PEDAGOGIQUES
// ==========================================

model TeacherAppreciation {
  id        String @id @default(cuid())
  studentId String
  teacherId String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  teacher User @relation("UserTeacherAppreciations", fields: [teacherId], references: [id], onDelete: Cascade)

  subject String
  term    String
  comment String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([studentId, subject, term])
  @@index([studentId])
  @@index([teacherId])
}

// ==========================================
// PROFIL PARENT
// ==========================================

model ParentProfile {
  id     String @id @default(cuid())
  userId String @unique

  user User @relation("UserToParentProfile", fields: [userId], references: [id], onDelete: Cascade)

  phone   String?
  address String?
  job     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ==========================================
// CLASSES
// ==========================================

model Class {
  id            String        @id @default(cuid())
  name          String
  level         String
  educationType EducationType @default(SCHOOL)

  students            Student[]
  teachingAssignments TeachingAssignment[]
  schedules           Schedule[]

  @@unique([name, level])
}

// ==========================================
// ELEVES
// ==========================================

model Student {
  id     String @id @default(cuid())
  userId String @unique

  user User @relation("UserToStudent", fields: [userId], references: [id], onDelete: Cascade)

  parentId String?

  parent User? @relation("ParentToStudent", fields: [parentId], references: [id], onDelete: SetNull)

  classId String

  class Class @relation(fields: [classId], references: [id])

  grades                 Grade[]                 @relation("StudentGrades")
  invoices               Invoice[]               @relation("StudentInvoices")
  teacherAppreciations   TeacherAppreciation[]
  absences               Absence[]
  homeworkSubmissions    HomeworkSubmission[]
  lessonProgress         StudentLessonProgress[]
  learningAttempts       LearningAttempt[]
  onlineHomeworkAttempts OnlineHomeworkAttempt[]

  @@index([parentId])
  @@index([classId])
}

// ==========================================
// AFFECTATIONS PEDAGOGIQUES
// ==========================================

model TeachingAssignment {
  id        String   @id @default(cuid())
  teacherId String
  classId   String
  subject   String
  createdAt DateTime @default(now())

  teacher User @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  // Exercices associés à cette affectation
  exercises Exercise[]

  homeworks       Homework[]
  learningCourses LearningCourse[]

  @@unique([teacherId, classId, subject])
  @@index([teacherId])
  @@index([classId])
}

// ==========================================
// NOTES ET VALIDATION ADMINISTRATIVE
// ==========================================

model Grade {
  id String @id @default(cuid())

  studentId String

  student Student @relation("StudentGrades", fields: [studentId], references: [id], onDelete: Cascade)

  subject        String
  score          Float
  coef           Int      @default(1)
  term           String
  evaluationDate DateTime @default(now())

  // Cycle de validation
  status GradeApprovalStatus @default(PENDING)

  // Enseignant ayant soumis la note
  submittedById String?

  submittedBy User? @relation("SubmittedGrades", fields: [submittedById], references: [id], onDelete: SetNull)

  // Administrateur ayant traité la note
  reviewedById String?

  reviewedBy User? @relation("ReviewedGrades", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt    DateTime?
  reviewComment String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([studentId, term])
  @@index([studentId, subject])
  @@index([status, createdAt])
  @@index([submittedById, status])
  @@index([reviewedById])
}

// ==========================================
// FACTURATION SCOLAIRE
// ==========================================

model Invoice {
  id        String        @id @default(cuid())
  studentId String
  parentId  String
  amount    Float
  dueDate   DateTime
  status    InvoiceStatus @default(PENDING)
  createdAt DateTime      @default(now())

  student Student @relation("StudentInvoices", fields: [studentId], references: [id], onDelete: Cascade)

  parent User @relation("ParentInvoices", fields: [parentId], references: [id], onDelete: Cascade)

  payments Payment[]

  @@index([studentId])
  @@index([parentId])
  @@index([status])
}

// ==========================================
// PAIEMENTS
// ==========================================

model Payment {
  id           String   @id @default(cuid())
  invoiceId    String
  provider     String
  providerTxId String?  @unique
  phone        String?
  amount       Float
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ==========================================
// EMPLOIS DU TEMPS
// ==========================================

model Schedule {
  id        String   @id @default(cuid())
  classId   String
  teacherId String
  subject   String
  dayOfWeek String
  startTime String
  endTime   String
  room      String?
  createdAt DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  teacher User @relation("TeacherSchedules", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([classId])
}

// ==========================================
// ABSENCES
// ==========================================

model Absence {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime @default(now())
  reason    String?  @db.Text
  justified Boolean  @default(false)
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// ==========================================
// EXERCICES PEDAGOGIQUES
// ==========================================

model Exercise {
  id          String             @id @default(cuid())
  title       String             @db.VarChar(160)
  description String             @db.Text
  difficulty  ExerciseDifficulty @default(INTERMEDIATE)
  status      ExerciseStatus     @default(DRAFT)

  // Affectation classe + matière
  assignmentId String

  assignment TeachingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  // Auteur de l'exercice
  createdById String

  createdBy User @relation("CreatedExercises", fields: [createdById], references: [id], onDelete: Restrict)

  // Publication
  publishedAt DateTime?

  // Traçabilité
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([assignmentId, status, createdAt])
  @@index([createdById, createdAt])
}

enum HomeworkType {
  UPLOAD
  ONLINE
}

enum HomeworkStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Homework {
  id              String         @id @default(cuid())
  title           String         @db.VarChar(180)
  instructions    String         @db.Text
  type            HomeworkType
  status          HomeworkStatus @default(DRAFT)
  durationMinutes Int?
  dueDate         DateTime?

  assignmentId String
  assignment   TeachingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("CreatedHomeworks", fields: [createdById], references: [id], onDelete: Restrict)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  submissions     HomeworkSubmission[]
  onlineQuestions OnlineHomeworkQuestion[]
  onlineAttempts  OnlineHomeworkAttempt[]

  @@index([assignmentId, status, dueDate])
  @@index([createdById, status, createdAt])
}

// ==========================================
// COPIES RENDUES PAR LES ÉLÈVES
// ==========================================

enum SubmissionStatus {
  PENDING
  GRADED
}

model HomeworkSubmission {
  id          String           @id @default(cuid())
  homeworkId  String
  studentId   String
  fileName    String           @db.VarChar(200)
  mimeType    String           @db.VarChar(150)
  fileData    Bytes            @db.ByteA
  status      SubmissionStatus @default(PENDING)
  score       Float?
  feedback    String?          @db.Text
  submittedAt DateTime         @default(now())
  gradedAt    DateTime?
  gradedById  String?
  updatedAt   DateTime         @updatedAt

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Restrict)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  gradedBy User?    @relation("GradedHomeworkSubmissions", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([homeworkId, studentId])
  @@index([homeworkId, submittedAt])
  @@index([studentId, submittedAt])
  @@index([status, submittedAt])
}

// ==========================================
// PARCOURS PROGRESSIFS ET EVALUATIONS
// ==========================================

model LearningCourse {
  id           String               @id @default(cuid())
  title        String               @db.VarChar(180)
  description  String               @db.Text
  status       LearningCourseStatus @default(DRAFT)
  assignmentId String
  assignment   TeachingAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  lessons      LearningLesson[]
  assessments  LearningAssessment[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([assignmentId, status])
}

model LearningLesson {
  id               String                  @id @default(cuid())
  courseId         String
  course           LearningCourse          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  position         Int
  title            String                  @db.VarChar(180)
  content          String                  @db.Text
  estimatedMinutes Int                     @default(15)
  resourceUrl      String?                 @db.Text
  progress         StudentLessonProgress[]
  createdAt        DateTime                @default(now())

  @@unique([courseId, position])
}

model StudentLessonProgress {
  id          String         @id @default(cuid())
  studentId   String
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      LearningLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime       @default(now())

  @@unique([studentId, lessonId])
  @@index([studentId, completedAt])
}

model LearningAssessment {
  id           String                 @id @default(cuid())
  courseId     String
  course       LearningCourse         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  kind         LearningAssessmentKind
  passingScore Int                    @default(70)
  published    Boolean                @default(false)
  questions    LearningQuestion[]
  attempts     LearningAttempt[]

  @@unique([courseId, kind])
}

model LearningQuestion {
  id            String             @id @default(cuid())
  assessmentId  String
  assessment    LearningAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  position      Int
  prompt        String             @db.Text
  optionA       String             @db.Text
  optionB       String             @db.Text
  optionC       String             @db.Text
  optionD       String             @db.Text
  correctOption String             @db.VarChar(1)

  @@unique([assessmentId, position])
}

model LearningAttempt {
  id           String             @id @default(cuid())
  studentId    String
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   LearningAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  percentScore Int
  level        LearningLevel?
  createdAt    DateTime           @default(now())

  @@index([studentId, assessmentId, createdAt])
}

// ==========================================
// COMPOSITIONS ET EVALUATIONS EN LIGNE
// ==========================================

// ==========================================
// 1. QUESTIONS DES COMPOSITIONS
// ==========================================

model OnlineHomeworkQuestion {
  id String @id @default(cuid())

  // Devoir auquel appartient la question
  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  // Ordre de la question
  position Int

  // Énoncé
  prompt String @db.Text

  // Propositions de réponses
  optionA String @db.Text
  optionB String @db.Text
  optionC String @db.Text
  optionD String @db.Text

  // Bonne réponse : A, B, C ou D
  correctOption String @db.VarChar(1)

  // Points attribués
  points Int @default(1)

  // Réponses des apprenants
  answers OnlineHomeworkAnswer[]

  @@unique([homeworkId, position])
  @@index([homeworkId])
}

// ==========================================
// 2. TENTATIVES DES APPRENANTS
// ==========================================

model OnlineHomeworkAttempt {
  id String @id @default(cuid())

  // Composition
  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Restrict)

  // Apprenant
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Début de la composition
  startedAt DateTime @default(now())

  // Fin autorisée, calculée côté serveur
  expiresAt DateTime

  // Dernière activité
  lastActivityAt DateTime?

  // Date de soumission définitive
  submittedAt DateTime?

  // Résultats calculés côté serveur
  scorePercent   Int?
  correctAnswers Int?
  totalQuestions Int?

  // Réponses enregistrées
  answers OnlineHomeworkAnswer[]

  // Une tentative par apprenant et devoir
  @@unique([homeworkId, studentId])
  @@index([studentId, submittedAt])
  @@index([expiresAt, submittedAt])
}

// ==========================================
// 3. REPONSES DES APPRENANTS
// ==========================================

model OnlineHomeworkAnswer {
  id String @id @default(cuid())

  // Tentative concernée
  attemptId String
  attempt   OnlineHomeworkAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  // Question concernée
  questionId String
  question   OnlineHomeworkQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  // Choix de l'apprenant : A, B, C ou D
  choice String @db.VarChar(1)

  // Date de dernière modification
  updatedAt DateTime @updatedAt

  // Une seule réponse par question et tentative
  @@unique([attemptId, questionId])
  @@index([questionId])
}
