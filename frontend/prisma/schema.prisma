generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(STUDENT)
  accounts      Account[]
  sessions      Session[]
  
  // Relations Profils
  studentProfile Student?        @relation("UserToStudent")
  teacherProfile TeacherProfile? @relation("UserToTeacher") 
  parentProfile  ParentProfile?  @relation("UserToParentProfile")

  // Autres relations
  parentStudents       Student[]             @relation("ParentToStudent")
  invoices             Invoice[]             @relation("ParentInvoices")
  teacherAssignments   TeachingAssignment[]  @relation("TeacherAssignments")
  schedules            Schedule[]            @relation("TeacherSchedules")
  teacherAppreciations TeacherAppreciation[] @relation("UserTeacherAppreciations")
}

// ==========================================
// MODÈLE : PROFIL ENSEIGNANT
// ==========================================
model TeacherProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation("UserToTeacher", fields: [userId], references: [id], onDelete: Cascade)
  
  phone           String?  // Numéro de contact (ex: +225 07...)
  address         String?  // Lieu de résidence (ex: Cocody Angré)
  specialty       String?  // Matière de prédilection (ex: Mathématiques)
  degree          String?  // Diplôme (ex: Master 2 en Sciences)
  pedagogicalInfo String?  @db.Text // Notes libres, disponibilités, ou remarques du directeur

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TeacherAppreciation {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User     @relation("UserTeacherAppreciations", fields: [teacherId], references: [id], onDelete: Cascade)
  subject   String
  term      String   // Ex: "T1", "T2", "T3"
  comment   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subject, term])
  @@index([studentId])
  @@index([teacherId])
}

// ==========================================
// MODÈLE : PROFIL PARENT
// ==========================================
model ParentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation("UserToParentProfile", fields: [userId], references: [id], onDelete: Cascade)
  
  phone     String?  // Numéro de téléphone / WhatsApp
  address   String?  // Adresse du domicile (ex: Cocody, 2 Plateaux)
  job       String?  // Profession
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id                  String               @id @default(cuid())
  name                String
  level               String
  students            Student[]
  teachingAssignments TeachingAssignment[]
  schedules           Schedule[]

  @@unique([name, level])
}

model Student {
  id                   String                @id @default(cuid())
  userId               String                @unique
  user                 User                  @relation("UserToStudent", fields: [userId], references: [id], onDelete: Cascade)
  parentId             String?
  parent               User?                 @relation("ParentToStudent", fields: [parentId], references: [id], onDelete: SetNull)
  classId              String
  class                Class                 @relation(fields: [classId], references: [id])
  grades               Grade[]               @relation("StudentGrades")
  invoices             Invoice[]             @relation("StudentInvoices")
  teacherAppreciations TeacherAppreciation[]
  absences             Absence[]             // Relation inverse pour les absences

  @@index([parentId])
  @@index([classId])
}

model TeachingAssignment {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   String
  createdAt DateTime @default(now())

  @@unique([teacherId, classId, subject])
  @@index([teacherId])
  @@index([classId])
}

model Grade {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation("StudentGrades", fields: [studentId], references: [id], onDelete: Cascade)
  subject        String
  score          Float
  coef           Int      @default(1)
  term           String
  evaluationDate DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([studentId, term])
  @@index([studentId, subject])
}

model Invoice {
  id        String        @id @default(cuid())
  studentId String
  student   Student       @relation("StudentInvoices", fields: [studentId], references: [id], onDelete: Cascade)
  parentId  String
  parent    User          @relation("ParentInvoices", fields: [parentId], references: [id], onDelete: Cascade)
  amount    Float
  dueDate   DateTime
  status    InvoiceStatus @default(PENDING)
  createdAt DateTime      @default(now())
  payments  Payment[]

  @@index([studentId])
  @@index([parentId])
  @@index([status])
}

model Payment {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  provider     String   // "WAVE" | "ORANGE_MONEY"
  providerTxId String?  @unique // id Wave/OM
  phone        String?
  amount       Float
  status       String   @default("PENDING") // PENDING | SUCCESS | FAILED
  createdAt    DateTime @default(now())

  @@index([invoiceId])
}

model Schedule {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User     @relation("TeacherSchedules", fields: [teacherId], references: [id], onDelete: Cascade)
  subject   String   // Ex: Mathématiques
  dayOfWeek String   // Ex: "Lundi", "Mardi", etc.
  startTime String   // Ex: "08:00"
  endTime   String   // Ex: "10:00"
  room      String?  // Ex: "Salle 102"
  createdAt DateTime @default(now())

  @@index([teacherId])
  @@index([classId])
}

model Absence {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  reason    String?  @db.Text
  justified Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([studentId])
}